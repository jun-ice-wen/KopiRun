    function ReceiptSlip({ slots, onReset }) {
      const [copied, setCopied] = useState(false);
      const [formatMode, setFormatMode] = useState('local');
      const [tab, setTab] = useState('stall');

      const active = slots.filter(s => s.active);
      const totalCount = active.length;
      const grouped = groupDrinkOrders(slots);
      const icedCount = active.filter(s => s.modifiers.iced).length;
      const hotCount = totalCount - icedCount;

      const handleCopy = async () => {
        if (totalCount === 0) return;
        const text = generateClipboardText(slots, formatMode);
        try {
          if (navigator.clipboard) await navigator.clipboard.writeText(text);
          else {
            const ta = document.createElement('textarea');
            ta.value = text;
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
          }
          setCopied(true);
          setTimeout(() => setCopied(false), 2200);
        } catch(e) {}
      };

      const handleWhatsApp = () => {
        if (totalCount === 0) return;
        const text = generateClipboardText(slots, formatMode);
        window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(text)}`, '_blank');
      };

      const handleTelegram = () => {
        if (totalCount === 0) return;
        const text = generateClipboardText(slots, formatMode);
        window.open(`https://t.me/share/url?url=&text=${encodeURIComponent(text)}`, '_blank');
      };

      return (
        <div className="bg-slate-50 rounded-3xl border border-blue-200 shadow-md overflow-hidden relative">
          <div className="bg-slate-900 text-slate-100 p-4 sm:p-5">
            <div className="flex items-center justify-between mb-3">
              <div className="flex items-center gap-2">
                <span className="w-2.5 h-2.5 rounded-full bg-blue-400"></span>
                <span className="font-receipt text-xs tracking-widest uppercase text-slate-300">KOPITIAM ORDER CHIT</span>
              </div>
              <span className="font-receipt text-xs text-blue-400 font-bold">{totalCount} DRINKS</span>
            </div>

            <div className="flex items-end justify-between">
              <div>
                <h2 className="font-display text-xl sm:text-2xl font-bold tracking-tight text-white">Drink Order Slip</h2>
                <p className="text-xs text-slate-400">Auto-grouped for ordering at the stall</p>
              </div>
              <div className="border-2 border-blue-400/80 text-blue-300 px-2.5 py-1 rounded-md rotate-[-4deg] text-[10px] font-receipt font-bold tracking-wider uppercase select-none">
                新加坡 咖啡店
              </div>
            </div>

            <div className="grid grid-cols-2 gap-2 mt-4 pt-3 border-t border-slate-800 text-xs">
              <div className="flex items-center gap-2 bg-slate-800/80 px-3 py-1.5 rounded-xl border border-slate-700/60">
                <span>🔥</span>
                <span className="text-slate-300">Hot Drinks:</span>
                <span className="font-receipt font-bold text-white ml-auto">{hotCount}</span>
              </div>
              <div className="flex items-center gap-2 bg-slate-800/80 px-3 py-1.5 rounded-xl border border-slate-700/60">
                <span>🧊</span>
                <span className="text-slate-300">Iced (Peng):</span>
                <span className="font-receipt font-bold text-white ml-auto">{icedCount}</span>
              </div>
            </div>
          </div>

          <div className="px-4 py-3 bg-blue-50/70 border-b border-blue-100 flex flex-wrap items-center justify-between gap-2 text-xs">
            <div className="flex items-center p-0.5 bg-white rounded-xl border border-blue-200">
              <button
                type="button"
                onClick={() => setTab('stall')}
                className={`px-3 py-1.5 rounded-lg font-semibold min-h-[36px] ${tab === 'stall' ? 'bg-blue-600 text-white' : 'text-slate-600'}`}
              >
                Stall Order ({grouped.length})
              </button>
              <button
                type="button"
                onClick={() => setTab('distribution')}
                className={`px-3 py-1.5 rounded-lg font-semibold min-h-[36px] ${tab === 'distribution' ? 'bg-blue-600 text-white' : 'text-slate-600'}`}
              >
                Who Ordered ({totalCount})
              </button>
            </div>

            <button
              type="button"
              onClick={() => setFormatMode(formatMode === 'local' ? 'descriptive' : 'local')}
              className="text-blue-700 hover:text-blue-950 font-medium underline min-h-[36px] px-1"
            >
              {formatMode === 'local' ? 'Switch to Plain English' : 'Switch to Kopitiam Lingo'}
            </button>
          </div>

          <div className="p-4 sm:p-5 space-y-4">
            {totalCount === 0 ? (
              <div className="py-10 text-center text-slate-500">
                <p className="font-semibold text-slate-800 text-sm">No drinks in tabulator</p>
                <p className="text-xs text-slate-500 mt-1">Add drink slots on the left or tap a Quick Add preset.</p>
              </div>
            ) : tab === 'stall' ? (
              <div className="space-y-2">
                <div className="text-[11px] font-bold text-slate-500 uppercase tracking-wider flex items-center justify-between pb-1 border-b border-blue-200/60">
                  <span>Item Description</span>
                  <span>Qty</span>
                </div>
                {grouped.map((item, idx) => (
                  <div key={item.key + idx} className="bg-white p-3 rounded-xl border border-blue-100 flex items-center justify-between gap-3">
                    <div className="min-w-0 flex-1">
                      <span className="font-display font-bold text-slate-900 text-sm sm:text-base leading-snug">
                        {formatMode === 'local' ? item.localName : item.descriptiveName}
                      </span>
                      <div className="text-[11px] text-slate-500 truncate mt-0.5">
                        For: {item.personNames.join(', ')}
                      </div>
                    </div>
                    <div className="shrink-0 flex items-center gap-2">
                      <span className={`text-[11px] font-medium px-2 py-0.5 rounded border ${item.isIced ? 'text-sky-700 bg-sky-50 border-sky-200' : 'text-blue-800 bg-blue-50 border-blue-200'}`}>
                        {item.isIced ? 'Iced' : 'Hot'}
                      </span>
                      <div className="w-9 h-9 rounded-lg bg-blue-600 text-white font-receipt font-bold text-sm flex items-center justify-center">
                        {item.quantity}x
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <div className="space-y-2 max-h-[380px] overflow-y-auto pr-1">
                <div className="text-[11px] font-bold text-slate-500 uppercase tracking-wider pb-1 border-b border-blue-200/60">
                  Distribution Roster
                </div>
                {active.map(slot => (
                  <div key={slot.id} className="bg-white p-2.5 rounded-xl border border-blue-100 flex items-center justify-between gap-2 text-xs">
                    <div className="flex items-center gap-2 min-w-0">
                      <span className="font-receipt font-bold text-blue-700 bg-blue-50 px-1.5 py-0.5 rounded text-[11px]">
                        #{String(slot.slotNumber).padStart(2, '0')}
                      </span>
                      <span className="font-bold text-slate-900 truncate">{getDisplayName(slot)}</span>
                    </div>
                    <span className="font-semibold text-slate-800 truncate">
                      {formatMode === 'local' ? formatLocalKopitiamName(slot) : formatDescriptiveName(slot)}
                    </span>
                  </div>
                ))}
              </div>
            )}

            {totalCount > 0 && (
              <div className="space-y-2.5 pt-3 border-t border-blue-200/80">
                <button
                  type="button"
                  onClick={handleCopy}
                  className={`w-full py-3 px-4 rounded-xl font-bold text-sm flex items-center justify-center gap-2 transition-all min-h-[48px] ${
                    copied ? 'bg-emerald-600 text-white' : 'bg-blue-600 hover:bg-blue-500 text-white'
                  }`}
                >
                  <span>{copied ? '✓ Copied for WhatsApp / Telegram!' : '📋 Copy Formatted Summary'}</span>
                </button>

                <div className="grid grid-cols-2 gap-2">
                  <button
                    type="button"
                    onClick={handleWhatsApp}
                    className="flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white font-semibold text-xs min-h-[44px]"
                  >
                    <span>Share WhatsApp</span>
                  </button>
                  <button
                    type="button"
                    onClick={handleTelegram}
                    className="flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-xl bg-sky-500 hover:bg-sky-600 text-white font-semibold text-xs min-h-[44px]"
                  >
                    <span>Share Telegram</span>
                  </button>
                </div>

                <button
                  type="button"
                  onClick={onReset}
                  className="w-full py-2 px-3 rounded-xl text-slate-500 hover:text-red-600 hover:bg-red-50 text-xs font-semibold flex items-center justify-center min-h-[40px]"
                >
                  <span>Reset All 20 Order Slots</span>
                </button>
              </div>
            )}
          </div>
        </div>
      );
    }

    ReactDOM.createRoot(document.getElementById('root')).render(<App />);
  </script>
</body>
</html>
