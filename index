        const res = sanitizeModifiers(base, slot.modifiers);
        setNotice(res.ruleTriggered ? res.ruleExplanation : null);
        onUpdate({ ...slot, baseDrink: base, modifiers: res.modifiers });
      };

      const handleMilk = (milk) => {
        let sw = slot.modifiers.sweetness;
        let not = null;
        if ((slot.baseDrink === 'kopi' || slot.baseDrink === 'teh') && milk === 'none' && sw === 'kosong') {
          sw = 'normal';
          not = `Standard ${slot.baseDrink === 'kopi' ? 'Kopi' : 'Teh'} uses sweet condensed milk. "Kosong" reset to regular. Select O or C for zero sugar.`;
        }
        setNotice(not);
        onUpdate({ ...slot, modifiers: { ...slot.modifiers, milk, sweetness: sw } });
      };

      const handleSweetness = (sweetness) => {
        let m = slot.modifiers.milk;
        let not = null;
        if ((slot.baseDrink === 'kopi' || slot.baseDrink === 'teh') && sweetness === 'kosong' && m === 'none') {
          m = 'o';
          not = `Default ${slot.baseDrink === 'kopi' ? 'Kopi' : 'Teh'} has sweet condensed milk, so "${slot.baseDrink === 'kopi' ? 'Kopi' : 'Teh'} Kosong" cannot exist! Switched to ${slot.baseDrink === 'kopi' ? 'Kopi' : 'Teh'}-O Kosong.`;
