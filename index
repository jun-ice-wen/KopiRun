<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>KopiRun - Singapore Kopitiam Drink Order Tabulator</title>
  <meta name="description" content="Mobile-optimized Singapore kopitiam drink order tabulator with automatic grouping and WhatsApp clipboard export." />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"DM Sans"', 'system-ui', 'sans-serif'],
            display: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
            receipt: ['"Space Mono"', 'monospace'],
          }
        }
      }
    }
  </script>

  <!-- React 18 & Babel UMD for Standalone Browser Execution -->
  <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
  <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

  <style>
    body {
      font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      -webkit-tap-highlight-color: transparent;
    }
    .font-display { font-family: 'Plus Jakarta Sans', sans-serif; }
    .font-receipt { font-family: 'Space Mono', monospace; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>
<body class="bg-slate-100 text-slate-900 antialiased selection:bg-blue-200">
  <div id="root"></div>

  <script type="text/babel">
    const { useState, useEffect, useRef } = React;

    const MAX_DRINK_SLOTS = 20;
    const STORAGE_KEY = 'kopirun_standalone_v2';

    const CUTE_ANIMAL_NAMES = [
      'Curious Otter 🦦', 'Sleepy Panda 🐼', 'Chill Capybara 🦫', 'Fluffy Bunny 🐰',
      'Happy Penguin 🐧', 'Smiling Quokka 🦔', 'Cozy Koala 🐨', 'Gentle Corgi 🐶',
      'Playful Kitten 🐱', 'Sunny Duckling 🐥', 'Cheeky Hamster 🐹', 'Clever Fox 🦊',
      'Gentle Alpaca 🦙', 'Baby Seal 🦭', 'Sweet Sloth 🦥', 'Merry Shiba 🐕',
      'Brisk Chipmunk 🐿️', 'Little Hedgehog 🦔', 'Alert Meerkat 🐾', 'Red Panda 🦊'
    ];

    function getCuteAnimalName(slotNumber) {
      const idx = Math.max(0, slotNumber - 1) % CUTE_ANIMAL_NAMES.length;
      return CUTE_ANIMAL_NAMES[idx];
    }

    function getDisplayName(slot) {
      if (slot.personName && slot.personName.trim()) {
        return slot.personName.trim();
      }
      return getCuteAnimalName(slot.slotNumber);
    }

    const BASE_DRINKS = [
      { id: 'kopi', name: 'Kopi', chinese: '咖啡', hasMilk: true, hasSweetness: true, hasGao: true },
      { id: 'teh', name: 'Teh', chinese: '茶', hasMilk: true, hasSweetness: true, hasGao: true },
      { id: 'milo', name: 'Milo', chinese: '美禄', hasMilk: true, hasSweetness: true, hasGao: true },
      { id: 'green_tea', name: 'Green Tea', chinese: '绿茶 (热)', hasMilk: false, hasSweetness: false, hasGao: false },
      { id: 'chinese_tea', name: 'Chinese Tea', chinese: '中国茶 (热)', hasMilk: false, hasSweetness: false, hasGao: false },
      { id: 'honey_lemon', name: 'Honey Lemon', chinese: '蜂蜜柠檬 (热)', hasMilk: false, hasSweetness: true, hasGao: false },
      { id: 'coke_zero', name: 'Coke-zero', chinese: '无糖可乐 (冰)', hasMilk: false, hasSweetness: false, hasGao: false },
      { id: 'others', name: 'Others', chinese: '其他饮料', hasMilk: false, hasSweetness: true, hasGao: false },
    ];

    const PRESETS = [
      { label: 'Kopi', sub: 'Standard', base: 'kopi', mod: { milk: 'none', sweetness: 'normal', iced: false }, bg: 'bg-blue-50 text-blue-900 border-blue-200' },
      { label: 'Kopi-O Kosong', sub: 'Black, 0 Sugar', base: 'kopi', mod: { milk: 'o', sweetness: 'kosong', iced: false }, bg: 'bg-slate-900 text-white border-slate-800' },
      { label: 'Teh-C Siew Dai', sub: 'Evap milk, less sweet', base: 'teh', mod: { milk: 'c', sweetness: 'siew_dai', iced: false }, bg: 'bg-sky-50 text-sky-900 border-sky-200' },
      { label: 'Teh Peng', sub: 'Iced Milk Tea', base: 'teh', mod: { milk: 'none', sweetness: 'normal', iced: true }, bg: 'bg-blue-100 text-blue-950 border-blue-300' },
      { label: 'Milo Peng', sub: 'Iced Malt Drink', base: 'milo', mod: { milk: 'none', sweetness: 'normal', iced: true }, bg: 'bg-cyan-100 text-cyan-950 border-cyan-300' },
      { label: 'Honey Lemon', sub: 'Hot Siew Dai', base: 'honey_lemon', mod: { sweetness: 'siew_dai', iced: false }, bg: 'bg-indigo-50 text-indigo-900 border-indigo-200' },
      { label: 'Coke-zero', sub: 'Iced', base: 'coke_zero', mod: { iced: true }, bg: 'bg-slate-100 text-slate-900 border-slate-300' },
    ];

    function isHotOnly(base) {
      return base === 'green_tea' || base === 'chinese_tea' || base === 'honey_lemon';
    }

    function isIcedOnly(base) {
      return base === 'coke_zero';
    }

    function canChooseTemp(base) {
      return !isHotOnly(base) && !isIcedOnly(base);
    }

    function sanitizeModifiers(baseDrink, mod) {
      let m = { ...mod };
      let ruleTriggered = false;
      let ruleExplanation = null;

      if (isHotOnly(baseDrink)) {
        m.iced = false;
      } else if (isIcedOnly(baseDrink)) {
        m.iced = true;
      }

      if (baseDrink === 'honey_lemon' && m.sweetness === 'kosong') {
        m.sweetness = 'normal';
      }

      if ((baseDrink === 'kopi' || baseDrink === 'teh') && m.sweetness === 'kosong' && m.milk === 'none') {
        m.milk = 'o';
        ruleTriggered = true;
        const drinkName = baseDrink === 'kopi' ? 'Kopi' : 'Teh';
        ruleExplanation = `Kopitiam rule: ${drinkName} uses sweet condensed milk, so "${drinkName} Kosong" cannot exist! Switched to ${drinkName}-O Kosong (black). Choose "C" for evaporated milk.`;
      }

      if (['green_tea', 'chinese_tea', 'coke_zero', 'honey_lemon', 'others'].includes(baseDrink)) {
        m.milk = 'none';
        m.gao = false;
      }

      if (['green_tea', 'chinese_tea', 'coke_zero'].includes(baseDrink)) {
        m.sweetness = 'normal';
      }

      return { modifiers: m, ruleTriggered, ruleExplanation };
    }

    // Naming convention: 'base beverage' 'milk type' 'sweetness'
    function formatLocalKopitiamName(slot) {
      const { baseDrink, modifiers, customName } = slot;

      if (baseDrink === 'coke_zero') return 'Coke-zero (Iced)';
      if (baseDrink === 'chinese_tea') return 'Chinese Tea (Hot)';
      if (baseDrink === 'green_tea') return 'Green Tea (Hot)';
      if (baseDrink === 'honey_lemon') {
        const sweetStr = modifiers.sweetness === 'siew_dai' ? ' Siew Dai' : '';
        return `Honey Lemon${sweetStr} (Hot)`;
      }
      if (baseDrink === 'others') {
        const title = customName?.trim() || 'Custom Drink';
        const sweetStr = modifiers.sweetness === 'siew_dai' ? ' Siew Dai' : modifiers.sweetness === 'kosong' ? ' Kosong' : '';
        const tempStr = modifiers.iced ? ' Peng' : '';
        return `${title}${sweetStr}${tempStr}`;
      }

      const baseName = baseDrink === 'kopi' ? 'Kopi' : baseDrink === 'teh' ? 'Teh' : 'Milo';
      const parts = [baseName];

      // 1. Milk type
      if (modifiers.milk === 'o') parts.push('O');
      else if (modifiers.milk === 'c') parts.push('C');
      else if (modifiers.milk === 'plus_c') parts.push('+C');

      // 2. Sweetness
      if (modifiers.sweetness === 'siew_dai') parts.push('Siew Dai');
      else if (modifiers.sweetness === 'kosong') parts.push('Kosong');

      // Additional modifiers
      if (modifiers.gao) parts.push('Gao');
      if (modifiers.iced) parts.push('Peng');

      let result = parts[0];
      for (let i = 1; i < parts.length; i++) {
        const part = parts[i];
        if (i === 1 && (part === 'O' || part === 'C' || part === '+C')) {
          result += '-' + part;
        } else {
          result += ' ' + part;
        }
      }
      return result;
    }

    function formatDescriptiveName(slot) {
      const { baseDrink, modifiers, customName } = slot;
      if (baseDrink === 'others') return customName?.trim() || 'Custom Drink';
      if (baseDrink === 'coke_zero') return 'Coke-zero (Iced)';
      if (baseDrink === 'chinese_tea') return 'Chinese Tea (Hot)';
      if (baseDrink === 'green_tea') return 'Green Tea (Hot)';
      if (baseDrink === 'honey_lemon') {
        const sw = modifiers.sweetness === 'siew_dai' ? 'Less Sweet' : 'Regular';
        return `Honey Lemon (Hot, ${sw})`;
      }

      const baseName = baseDrink === 'kopi' ? 'Coffee' : baseDrink === 'teh' ? 'Tea' : 'Milo';
      const desc = [];
      if (modifiers.iced) desc.push('Iced');
      desc.push(baseName);

      const notes = [];
      if (modifiers.milk === 'o') notes.push('Black / No Milk');
      else if (modifiers.milk === 'c') notes.push('Evap Milk');
      else if (modifiers.milk === 'plus_c') notes.push('Extra Evap Milk');
      else notes.push('Condensed Milk');

      if (modifiers.sweetness === 'siew_dai') notes.push('Less Sweet');
      else if (modifiers.sweetness === 'kosong') notes.push('Zero Sugar');

      if (modifiers.gao) notes.push('Extra Strong');
      return `${desc.join(' ')} (${notes.join(', ')})`;
    }

    function getDrinkCanonicalKey(slot) {
      const { baseDrink, modifiers, customName } = slot;
      if (baseDrink === 'others') {
        return `others_${(customName || '').trim().toLowerCase()}_${modifiers.sweetness}_${modifiers.iced}`;
      }
      return `${baseDrink}_${modifiers.milk}_${modifiers.sweetness}_${modifiers.gao ? 'gao' : 'std'}_${modifiers.iced ? 'iced' : 'hot'}`;
    }

    function groupDrinkOrders(slots) {
      const active = slots.filter(s => s.active);
      const map = new Map();

      for (const slot of active) {
        const key = getDrinkCanonicalKey(slot);
        const local = formatLocalKopitiamName(slot);
        const desc = formatDescriptiveName(slot);
        const person = getDisplayName(slot);

        if (!map.has(key)) {
          map.set(key, {
            key,
            localName: local,
            descriptiveName: desc,
            quantity: 1,
            personNames: [person],
            isIced: slot.modifiers.iced,
          });
        } else {
          const item = map.get(key);
          item.quantity += 1;
          item.personNames.push(person);
        }
      }
      return Array.from(map.values()).sort((a, b) => b.quantity - a.quantity || a.localName.localeCompare(b.localName));
    }

    function generateClipboardText(slots, mode = 'local') {
      const active = slots.filter(s => s.active);
      if (active.length === 0) return 'No drink orders entered yet.';

      const grouped = groupDrinkOrders(slots);
      const icedCount = active.filter(s => s.modifiers.iced).length;
      const hotCount = active.length - icedCount;
      const timeStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

      const lines = [
        `☕ *KOPITIAM DRINK ORDER* (${active.length} drinks)`,
        `🕒 Time: ${timeStr} · 🧊 ${icedCount} Iced · 🔥 ${hotCount} Hot`,
        `━━━━━━━━━━━━━━━━━━━━━━`,
        `*📋 ORDER SUMMARY (FOR UNCLE/AUNTIE):*`,
      ];

      for (const item of grouped) {
        const name = mode === 'local' ? item.localName : item.descriptiveName;
        lines.push(`• *${item.quantity}x* ${name}`);
      }

      lines.push(`━━━━━━━━━━━━━━━━━━━━━━`);
      lines.push(`*👥 WHO ORDERED WHAT:*`);

      for (const slot of active) {
        const person = getDisplayName(slot);
        const name = mode === 'local' ? formatLocalKopitiamName(slot) : formatDescriptiveName(slot);
        lines.push(`• ${person}: ${name}`);
      }

      lines.push(`━━━━━━━━━━━━━━━━━━━━━━`);
      lines.push(`_Tabulated via KopiRun 🇸🇬_`);
      return lines.join('\n');
    }

    function getInitialSlots() {
      const arr = [];
      for (let i = 1; i <= MAX_DRINK_SLOTS; i++) {
        arr.push({
          id: `slot-${i}`,
          slotNumber: i,
          personName: '',
          baseDrink: 'kopi',
          customName: '',
          modifiers: { milk: 'none', sweetness: 'normal', gao: false, iced: false },
          active: i === 1,
        });
      }
      return arr;
    }

    function getSampleSlots() {
      const samples = [
        { person: '', base: 'kopi', sweetness: 'kosong', milk: 'o', iced: false },
        { person: 'Wei Ling', base: 'kopi', sweetness: 'kosong', milk: 'o', iced: false },
        { person: '', base: 'teh', sweetness: 'siew_dai', milk: 'c', iced: true },
        { person: 'Sarah', base: 'teh', sweetness: 'siew_dai', milk: 'c', iced: true },
        { person: '', base: 'milo', sweetness: 'normal', milk: 'none', iced: true },
        { person: 'Auntie Tan', base: 'kopi', sweetness: 'siew_dai', milk: 'none', gao: true, iced: false },
        { person: '', base: 'honey_lemon', sweetness: 'siew_dai', iced: false },
        { person: 'Farhan', base: 'coke_zero', iced: true },
      ];
      const arr = [];
      for (let i = 1; i <= MAX_DRINK_SLOTS; i++) {
        const s = samples[i - 1];
        if (s) {
          arr.push({
            id: `slot-${i}`,
            slotNumber: i,
            personName: s.person,
            baseDrink: s.base,
            customName: '',
            modifiers: {
              milk: s.milk || 'none',
              sweetness: s.sweetness || 'normal',
              gao: !!s.gao,
              iced: isIcedOnly(s.base) ? true : isHotOnly(s.base) ? false : !!s.iced,
            },
            active: true,
          });
        } else {
          arr.push({
            id: `slot-${i}`,
            slotNumber: i,
            personName: '',
            baseDrink: 'kopi',
            customName: '',
            modifiers: { milk: 'none', sweetness: 'normal', gao: false, iced: false },
            active: false,
          });
        }
      }
      return arr;
    }

    function App() {
      const [slots, setSlots] = useState(() => {
        try {
          const s = localStorage.getItem(STORAGE_KEY);
          if (s) {
            const p = JSON.parse(s);
            if (Array.isArray(p) && p.length === MAX_DRINK_SLOTS) return p;
          }
        } catch(e) {}
        return getInitialSlots();
      });

      const [isResetOpen, setIsResetOpen] = useState(false);
      const [isMobileChitOpen, setIsMobileChitOpen] = useState(false);
      const [toastMsg, setToastMsg] = useState(null);
      const bottomListRef = useRef(null);

      useEffect(() => {
        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(slots)); } catch(e) {}
      }, [slots]);

      const showToast = (txt) => {
        setToastMsg(txt);
        setTimeout(() => setToastMsg(c => c === txt ? null : c), 2600);
      };

      const activeSlots = slots.filter(s => s.active);
      const activeCount = activeSlots.length;
      const availableSlots = MAX_DRINK_SLOTS - activeCount;

      const handleUpdateSlot = (updated) => {
        setSlots(prev => prev.map(s => s.id === updated.id ? updated : s));
      };

      const handleAddPreset = (base, mod) => {
        const next = slots.find(s => !s.active);
        if (!next) { showToast('All 20 slots full!'); return; }

        const sanitized = sanitizeModifiers(base, {
          milk: mod.milk ?? 'none',
          sweetness: mod.sweetness ?? 'normal',
          gao: mod.gao ?? false,
          iced: mod.iced ?? false,
        });

        const updated = {
          ...next,
          baseDrink: base,
          customName: '',
          modifiers: sanitized.modifiers,
          active: true,
        };
        setSlots(prev => prev.map(s => s.id === updated.id ? updated : s));
        showToast(`Added to Slot #${next.slotNumber} (${getCuteAnimalName(next.slotNumber)})`);
      };

      const handleAddNewSlot = () => {
        const next = slots.find(s => !s.active);
        if (!next) { showToast('All 20 slots full!'); return; }

        const updated = {
          ...next,
          baseDrink: 'kopi',
          customName: '',
          personName: '',
          modifiers: { milk: 'none', sweetness: 'normal', gao: false, iced: false },
          active: true,
        };
        setSlots(prev => prev.map(s => s.id === updated.id ? updated : s));
        showToast(`Activated Slot #${next.slotNumber} (${getCuteAnimalName(next.slotNumber)})`);
        setTimeout(() => bottomListRef.current?.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 100);
      };

      const handleDuplicate = (id) => {
        const src = slots.find(s => s.id === id);
        const tgt = slots.find(s => !s.active);
        if (!src || !tgt) { showToast('All 20 slots full!'); return; }

        const dup = {
          ...tgt,
          baseDrink: src.baseDrink,
          customName: src.customName,
          personName: src.personName ? `${src.personName} (2)` : '',
          modifiers: { ...src.modifiers },
          active: true,
        };
        setSlots(prev => prev.map(s => s.id === dup.id ? dup : s));
        showToast(`Duplicated to Slot #${tgt.slotNumber}`);
      };

      const handleDelete = (id) => {
        setSlots(prev => prev.map(s => s.id === id ? {
          ...s,
          active: false,
          personName: '',
          customName: '',
          baseDrink: 'kopi',
          modifiers: { milk: 'none', sweetness: 'normal', gao: false, iced: false },
        } : s));
        showToast('Slot cleared');
      };

      const handleResetConfirm = () => {
        setSlots(getInitialSlots());
        setIsResetOpen(false);
        showToast('All order slots cleared');
      };

      const handleCopyOrder = async () => {
        if (activeCount === 0) { showToast('No drinks to copy yet!'); return; }
        const text = generateClipboardText(slots, 'local');
        try {
          if (navigator.clipboard) await navigator.clipboard.writeText(text);
          else {
            const ta = document.createElement('textarea');
            ta.value = text;
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
          }
          showToast('Order summary copied to clipboard!');
        } catch(e) {
          showToast('Could not copy to clipboard');
        }
      };

      return (
        <div className="min-h-screen bg-slate-100 flex flex-col font-sans pb-24 lg:pb-12 text-slate-900">
          {/* Toast Notification */}
          {toastMsg && (
            <div className="fixed top-20 left-1/2 -translate-x-1/2 z-50 bg-slate-900 text-slate-100 px-4 py-2.5 rounded-2xl shadow-xl flex items-center gap-2 text-xs font-semibold border border-blue-500/40">
              <span className="text-blue-400">✓</span>
              <span>{toastMsg}</span>
            </div>
          )}

          {/* Header */}
          <header className="sticky top-0 z-30 bg-slate-900 text-slate-100 border-b border-slate-800 shadow-md">
            <div className="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
              <div className="flex items-center gap-3">
                <div className="w-9 h-9 rounded-lg bg-blue-600 flex items-center justify-center text-white font-bold text-lg">
                  ☕
                </div>
                <div>
                  <div className="flex items-center gap-2">
                    <span className="font-display text-lg font-bold tracking-tight text-white">KopiRun</span>
                    <span className="text-xs px-2 py-0.5 rounded bg-slate-800 text-blue-300 font-receipt border border-slate-700">
                      {activeCount}/{MAX_DRINK_SLOTS} Drinks
                    </span>
                  </div>
                  <p className="text-[11px] text-slate-400 hidden sm:block">Singapore Kopitiam Drink Order Tabulator</p>
                </div>
              </div>

              <div className="flex items-center gap-2">
                <button
                  type="button"
                  onClick={() => { setSlots(getSampleSlots()); showToast('Loaded 8 sample orders!'); }}
                  className="px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800 text-xs font-medium min-h-[44px]"
                >
                  Sample Order
                </button>
                {activeCount > 0 && (
                  <button
                    type="button"
                    onClick={() => setIsResetOpen(true)}
                    className="px-2.5 py-1.5 rounded-lg text-slate-400 hover:text-red-300 hover:bg-slate-800 text-xs font-medium min-h-[44px]"
                  >
                    Reset
                  </button>
                )}
                <button
                  type="button"
                  onClick={handleCopyOrder}
                  className="px-4 py-2 text-xs sm:text-sm font-semibold text-white bg-blue-600 hover:bg-blue-500 active:scale-95 rounded-lg shadow-sm min-h-[44px]"
                >
                  Copy Order
                </button>
              </div>
            </div>
          </header>

          {/* Tongue-in-cheek Hero Section */}
          <section className="bg-slate-900 text-slate-200 border-b border-slate-800">
            <div className="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-7">
              <div className="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div className="space-y-1 max-w-2xl">
                  <div className="flex items-center gap-2 text-xs font-semibold text-blue-400">
                    <span>☕ Office Drink Tabulator</span>
                  </div>
                  <h1 className="font-display text-2xl sm:text-3xl font-bold tracking-tight text-white leading-tight">
                    Order for the whole kampung without getting scolded by Uncle.
                  </h1>
                  <p className="text-slate-400 text-xs sm:text-sm">
                    Tally up to 20 drinks with zero confusion, keep the stall moving, and copy clean summaries straight to WhatsApp.
                  </p>
                </div>
                <button
                  type="button"
                  onClick={() => { setSlots(getSampleSlots()); showToast('Loaded 8 sample orders!'); }}
                  className="px-4 py-2.5 rounded-xl bg-blue-600/20 text-blue-300 hover:bg-blue-600/30 text-xs font-semibold border border-blue-500/40 min-h-[44px] shrink-0"
                >
                  ✨ Load Sample (8 Drinks)
                </button>
              </div>
            </div>
          </section>

          {/* Main Layout */}
          <main className="max-w-7xl mx-auto px-4 sm:px-6 pt-6 flex-1 w-full">
